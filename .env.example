# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API key for receipt reading (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: public URL for magic-link emails. Defaults to the address the app is visited at.
NEXT_PUBLIC_SITE_URL=
